# PostgreSQL connection strings from Neon.
# Use Neon's pooled URL (with -pooler in the hostname) for app requests.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true"
# Use Neon's direct, unpooled URL for Prisma schema commands.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Optional live integrations.
OPENWEATHER_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DATA_GOV_API_KEY=
MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Maximum official records stored by one daily sync.
MANDI_SYNC_LIMIT=1000
