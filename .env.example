# Local SQLite database. Prisma resolves this relative to database/schema.prisma.
DATABASE_URL="file:./dev.db"

# Optional live integrations. Authentication and the database work locally without these.
OPENWEATHER_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DATA_GOV_API_KEY=
MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Maximum official records stored by one daily sync.
MANDI_SYNC_LIMIT=1000
