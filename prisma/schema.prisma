generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingVisitType {
  LAB_VISIT
  PICKUP
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id           String              @id @default(cuid())
  name         String
  phone        String              @unique
  email        String?             @unique
  passwordHash String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  farmProfile  FarmProfile?
  bookings     SoilTestBooking[]
  cropScans    CropScanRecord[]

  @@map("users")
}

model FarmProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  location         String
  district         String?
  state            String?
  acreage          Float
  primaryCrops     String[]
  soilType         String?
  irrigationSource String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("farm_profiles")
}

model SoilTestBooking {
  id        String           @id @default(cuid())
  userId    String
  crop      String
  visitType BookingVisitType
  date      DateTime
  lab       String
  token     String           @unique
  status    BookingStatus    @default(REQUESTED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("soil_test_bookings")
}

model CropScanRecord {
  id         String   @id @default(cuid())
  userId     String
  crop       String
  disease    String
  confidence Float
  severity   String
  symptoms   String
  remedies   String
  imageUrl   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("crop_scan_records")
}

model MandiPriceRecord {
  id         String   @id @default(cuid())
  commodity  String
  variety    String
  state      String
  district   String
  market     String
  minPrice   Int
  maxPrice   Int
  modalPrice Int
  arrivals   Float?
  unit       String   @default("quintal")
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@index([commodity, state, recordedAt])
  @@index([market, recordedAt])
  @@map("mandi_price_records")
}

model ProcurementItem {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String
  price       Int
  unit        String
  certified   Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([category, active])
  @@map("procurement_items")
}
