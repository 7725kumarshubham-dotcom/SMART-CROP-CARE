generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String              @id @default(cuid())
  name         String
  phone        String              @unique
  email        String?             @unique
  passwordHash String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  farmProfile  FarmProfile?
  bookings     SoilTestBooking[]
  cropScans    CropScanRecord[]
  cropDiaryEntries CropDiaryEntry[]
  reminders    FarmReminder[]
  mandiPriceAlerts MandiPriceAlert[]
  authSessions AuthSession[]

  @@map("users")
}

model FarmProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  location         String
  district         String?
  state            String?
  acreage          Float
  primaryCrops     String   @default("[]")
  soilType         String?
  irrigationSource String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("farm_profiles")
}

model SoilTestBooking {
  id        String           @id @default(cuid())
  userId    String
  crop      String
  visitType String
  date      DateTime
  lab       String
  token     String           @unique
  status    String           @default("REQUESTED")
  createdAt DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  farmerAuthId String?
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("soil_test_bookings")
}

model CropScanRecord {
  id         String   @id @default(cuid())
  userId     String
  crop       String
  disease    String
  confidence Float
  severity   String
  symptoms   String
  remedies   String
  imageUrl   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("crop_scan_records")
}

model CropDiaryEntry {
  id        String   @id @default(cuid())
  userId    String
  crop      String
  activity  String
  date      DateTime
  notes     String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("crop_diary_entries")
}

model FarmReminder {
  id        String   @id @default(cuid())
  userId    String
  title     String
  crop      String?
  dueDate   DateTime
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed, dueDate])
  @@map("farm_reminders")
}

model MandiPriceRecord {
  id         String   @id @default(cuid())
  commodity  String
  variety    String
  state      String
  district   String
  market     String
  minPrice   Int
  maxPrice   Int
  modalPrice Int
  arrivals   Float?
  unit       String   @default("quintal")
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@index([commodity, state, recordedAt])
  @@index([market, recordedAt])
  @@unique([commodity, variety, state, district, market, recordedAt])
  @@map("mandi_price_records")
}

model OfficialMandiQuote {
  crop     String
  variety  String
  grade    String
  market   String
  state    String
  district String
  day      DateTime
  price    Float

  @@id([crop, variety, grade, market, state, district, day])
  @@index([crop, market, state, district, day])
  @@map("official_mandi_quotes")
}

model MandiPriceAlert {
  id         String   @id @default(cuid())
  userId     String
  crop       String
  variety    String
  state      String
  district   String
  market     String
  direction  String
  targetPrice Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, crop, state, market])
  @@map("mandi_price_alerts")
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model ProcurementItem {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String
  price       Int
  unit        String
  certified   Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([category, active])
  @@map("procurement_items")
}
